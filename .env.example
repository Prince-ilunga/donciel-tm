# ─────────────────────────────────────────────────────────────
# DONCIEL TM — Variables d'environnement
# Copie ce fichier en .env (JAMAIS commité !) et remplis les valeurs.
# Sur Vercel : Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ─── Requis ──────────────────────────────────────────────────
# PostgreSQL (Neon, Supabase, Railway…)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Clé de signature des sessions JWT — OBLIGATOIRE, 32+ caractères aléatoires.
# Génère-en une :  openssl rand -hex 32
JWT_SECRET=""

# URL publique de l'app (utilisée pour les emails et Stripe)
NEXT_PUBLIC_APP_URL="https://ton-domaine.com"

# ─── Optionnel : clé de récupération administrateur ──────────
# Protège la route POST /api/auth/setup (création/réinitialisation du compte admin).
# NON défini (recommandé en temps normal) = route DÉSACTIVÉE (403).
# À définir TEMPORAIREMENT sur Vercel uniquement pour réinitialiser un mot de
# passe admin oublié, puis SUPPRIMER + Redeploy. Voir src/app/api/auth/setup/route.ts
ADMIN_SETUP_KEY=""

# ─── Optionnel : SaaS ────────────────────────────────────────
# "true" (défaut) = inscription en libre-service immédiate (mode SaaS)
# "false" = les nouveaux comptes attendent l'approbation d'un admin (mode privé)
AUTO_APPROVE_REGISTRATIONS="true"

# Emails transactionnels (https://resend.com — free tier 100 mails/jour)
# Sans RESEND_API_KEY, les emails sont affichés dans les logs du serveur.
RESEND_API_KEY=""
EMAIL_FROM="DONCIEL TM <noreply@ton-domaine.com>"

# ─── Optionnel : Paddle (abonnements Pro / Elite — carte bancaire internationale)
# Paddle agit comme Merchant of Record (idéal si Stripe n'est pas dispo dans ton pays).
# 1. Crée un compte : https://www.paddle.com (sandbox : https://sandbox-vendors.paddle.com)
# 2. Crée les produits/prix dans Catalog → Products (prix récurrents mensuel + annuel)
# 3. Developer tools → Authentication → copie l'API key + client-side token
# 4. Developer tools → Notifications → webhook vers https://ton-domaine/api/billing/paddle/webhook
#    Événements : transaction.completed, subscription.created/activated/updated/resumed/canceled
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
# "production" en live, vide ou "sandbox" pour tester
PADDLE_ENV=""
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
PADDLE_PRICE_PRO_MONTHLY=""
PADDLE_PRICE_PRO_YEARLY=""
PADDLE_PRICE_ELITE_MONTHLY=""
PADDLE_PRICE_ELITE_YEARLY=""

# ─── Optionnel : Mobile Money RDC (paiement manuel validé par l'admin) ─────
# Le numéro affiché aux clients pour envoyer l'argent (M-Pesa / Airtel / Orange)
NEXT_PUBLIC_MM_NUMBER=""
NEXT_PUBLIC_MM_NAME="DONCIEL TM"

# ─── Optionnel : Stripe (gardé en réserve — ex: futur Stripe Atlas) ────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
STRIPE_PRICE_ELITE_YEARLY=""

# ─── Optionnel : existant ────────────────────────────────────
# Cloudinary (upload de vidéos/screenshots)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
