# ─────────────────────────────────────────────────────────────
# DONCIEL TM — Variables d'environnement
# Copie ce fichier en .env (JAMAIS commité !) et remplis les valeurs.
# Sur Vercel : Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ─── Requis ──────────────────────────────────────────────────
# PostgreSQL (Neon, Supabase, Railway…)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Clé de signature des sessions JWT — OBLIGATOIRE, 32+ caractères aléatoires.
# Génère-en une :  openssl rand -hex 32
JWT_SECRET=""

# URL publique de l'app (utilisée pour les emails et Stripe)
NEXT_PUBLIC_APP_URL="https://ton-domaine.com"

# ─── Optionnel : SaaS ────────────────────────────────────────
# "true" (défaut) = inscription en libre-service immédiate (mode SaaS)
# "false" = les nouveaux comptes attendent l'approbation d'un admin (mode privé)
AUTO_APPROVE_REGISTRATIONS="true"

# Emails transactionnels (https://resend.com — free tier 100 mails/jour)
# Sans RESEND_API_KEY, les emails sont affichés dans les logs du serveur.
RESEND_API_KEY=""
EMAIL_FROM="DONCIEL TM <noreply@ton-domaine.com>"

# ─── Optionnel : Stripe (abonnements Pro / Elite) ────────────
# Clé secrète : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Clé du webhook : https://dashboard.stripe.com/webhooks
#   Événements à écouter : checkout.session.completed,
#   customer.subscription.created/updated/deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""
# Prix Stripe (price_xxx) à créer dans le dashboard, un par plan/interval :
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
STRIPE_PRICE_ELITE_YEARLY=""

# ─── Optionnel : existant ────────────────────────────────────
# Cloudinary (upload de vidéos/screenshots)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
